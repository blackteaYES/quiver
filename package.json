{
  "name": "quiver",
  "productName": "Quiver",
  "version": "0.1.0",
  "description": "Quiver — local skill manager for coding harnesses",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,desktop -c \"#71717a,#e4e4e7\" \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/start-electron.mjs\"",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dist:win": "npm run build && electron-builder --win"
  },
  "keywords": [
    "skills",
    "harness",
    "electron",
    "developer-tools"
  ],
  "author": "Quiver Contributors",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
